{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  customManagers: [
    {
      customType: "regex",
      description: "Process OCI dependencies",
      managerFilePatterns: [
        "/^kubernetes/.+\\.yaml(?:\\.j2)?$/"
      ],
      matchStrings: [
        "oci://(?<depName>[^:]+):(?<currentValue>\\S+)",
      ],
      datasourceTemplate: "docker",
    },
    {
      // Handles the inline annotation form:
      //   # renovate: datasource=github-releases depName=owner/repo
      //   someKey: v1.2.3
      //
      // Without this manager the annotation is inert — Renovate simply
      // does not see the dependency, and there is no warning anywhere.
      // That is exactly how immich-server froze at v3.0.2 for 10 days
      // while immich-machine-learning kept auto-bumping (#13480). That
      // fix worked around the hole by setting `repository:` explicitly;
      // this closes it, so the next annotation anyone writes works.
      //
      // Regex is the one from home-operations/renovate-presets: it
      // covers YAML values, quoted values, anchors, and KEY=value env
      // lines.
      customType: "regex",
      description: "Process annotated dependencies",
      managerFilePatterns: [
        "/(^|/).+\\.ya?ml(?:\\.j2)?$/",
      ],
      matchStrings: [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?[\"']?(?<currentValue>[^\"'\\s]+)[\"']?",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
    {
      // Rook's Ceph operand (cephClusterSpec.cephVersion.image) is pinned
      // explicitly in the rook-ceph-cluster HelmRelease. The generic OCI /
      // annotation managers above do not track a bare `image: repo:tag`
      // line, so without this the pin would silently freeze — the exact
      // failure the annotated-dependencies manager cites for immich-server.
      // That freeze is worse for Ceph: v20.2.2 carries a mgr-module leak we
      // mitigate with a CronJob, so a leak-fixing 20.2.x must not be missed.
      // Scoped to quay.io/ceph/ceph, so it matches only the operand pin.
      customType: "regex",
      description: "Rook Ceph operand image (cephVersion.image)",
      managerFilePatterns: [
        "/^kubernetes/.+\\.yaml(?:\\.j2)?$/",
      ],
      matchStrings: [
        "image:\\s+(?<depName>quay\\.io/ceph/ceph):(?<currentValue>[^\\s@]+)(@(?<currentDigest>sha256:\\S+))?",
      ],
      datasourceTemplate: "docker",
    },
  ]
}
