{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  customManagers: [
    {
      customType: "regex",
      description: "Process OCI dependencies",
      managerFilePatterns: [
        "/^kubernetes/.+\\.yaml(?:\\.j2)?$/"
      ],
      matchStrings: [
        "oci://(?<depName>[^:]+):(?<currentValue>\\S+)",
      ],
      datasourceTemplate: "docker",
    },
    {
      // CNPG pins its Postgres engine image in the non-standard `imageName:`
      // field. The built-in kubernetes manager only matches `image:`, and no
      // manager above matches `imageName:`, so Renovate detected ZERO of the
      // ~25 CNPG clusters — the engine froze at 17.7 for months and only ever
      // moved by hand (dfe1a157ac). #13792's versioning fix was inert because
      // nothing fed it a dependency to version. This manager is the missing
      // detection half. Scoped to the cloudnative-pg/postgresql repo only, so
      // the vectorchord clusters (immich/khoj/langgraph-memory) keep their
      // deliberate 14.x digest pin untracked. Grouping + manual-merge gating
      // live in packageRules.json5 (fleet-wide blast radius).
      customType: "regex",
      description: "Process CNPG cluster engine imageName",
      managerFilePatterns: [
        "/^kubernetes/apps/databases/cloudnative-pg/config/.+/cluster\\.yaml$/",
      ],
      matchStrings: [
        "imageName:\\s+(?<depName>ghcr\\.io/cloudnative-pg/postgresql):(?<currentValue>\\S+)",
      ],
      datasourceTemplate: "docker",
    },
    {
      // Handles the inline annotation form:
      //   # renovate: datasource=github-releases depName=owner/repo
      //   someKey: v1.2.3
      //
      // Without this manager the annotation is inert — Renovate simply
      // does not see the dependency, and there is no warning anywhere.
      // That is exactly how immich-server froze at v3.0.2 for 10 days
      // while immich-machine-learning kept auto-bumping (#13480). That
      // fix worked around the hole by setting `repository:` explicitly;
      // this closes it, so the next annotation anyone writes works.
      //
      // Regex is the one from home-operations/renovate-presets: it
      // covers YAML values, quoted values, anchors, and KEY=value env
      // lines.
      customType: "regex",
      description: "Process annotated dependencies",
      managerFilePatterns: [
        "/(^|/).+\\.ya?ml(?:\\.j2)?$/",
      ],
      matchStrings: [
        "datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\n.+(:\\s|=)(&\\S+\\s)?[\"']?(?<currentValue>[^\"'\\s]+)[\"']?",
      ],
      datasourceTemplate: "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}",
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
    {
      // Tracks the ESPHome "github-package" pin form used by the git-tracked
      // device configs under kubernetes/apps/home/esphome/app/resources/:
      //   packages:
      //     some.key: github://<owner>/<repo>/<path>@<tag>
      // and the equivalent external_components `source:` form:
      //   - source: github://<owner>/<repo>@<tag>
      //
      // currentValue is deliberately restricted to tags that look like a
      // version (leading digit, optionally "v"-prefixed) so this does NOT
      // match a floating branch ref (`@main`) — three of the twelve configs
      // (bluetooth-proxy-wifi-1, bluetooth-proxy-wifi-2, pool-controller)
      // pin to `@main` on purpose and have no releases to track; apollo-
      // msr-2-296890 has no `@ref` at all. Only the six devices with a real
      // release tag (hass-voice x3, konnected, ratgdo x2) match and get
      // Renovate PRs. versioning=semver-coerced handles non-strict tags
      // like ratgdo's `v1535` (coerces to 1535.0.0) alongside strict
      // semver tags like `26.9.0` / `2026.6.0`.
      customType: "regex",
      description: "Process ESPHome github:// package pins",
      managerFilePatterns: [
        "/^kubernetes/apps/home/esphome/app/resources/.+\\.yaml$/"
      ],
      matchStrings: [
        "github://(?<depName>[^/\\s]+/[^/\\s]+)(?:/[^@\\s]+)?@(?<currentValue>v?\\d[\\w.-]*)",
      ],
      datasourceTemplate: "github-releases",
      versioningTemplate: "semver-coerced",
    },
  ]
}
