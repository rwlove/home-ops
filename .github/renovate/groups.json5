// Groups still bundle co-released sibling updates into a single PR,
// but minimumGroupSize is intentionally omitted: never hold a group
// off the PR queue waiting for siblings — open the PR with whatever
// updates are ready right now. The user wants PRs, not dashboard
// "force creation" entries.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      // UNGROUP the pinDigests sweep. Renovate's default config assigns every
      // pin/pinDigest update a shared groupName ("Pin Dependencies"), so all
      // ~100 first-time digest pins (pinDigests:true, renovate.json5) land in a
      // SINGLE branch, renovate/pin-dependencies. Building that one branch has
      // to resolve a digest for every dep at once, so a single dep whose digest
      // can't be resolved fails getUpdatedPackageFiles and the WHOLE branch
      // errors ("Error updating branch: update failure", dashboard #10329) —
      // the branch never even reaches the remote and zero pins land, retrying
      // forever. groupName:null splits the sweep into one branch per pin, so a
      // bad dep only fails its own PR (and surfaces in isolation) while the rest
      // auto-merge (autoMerge.json5 pinDigest rule) and trickle under the
      // prConcurrentLimit/prHourlyLimit caps — which is what renovate.json5's
      // "initial pin sweep trickles" comment already assumed. See memory
      // reference_renovate_pindigest_vs_digest_automerge (#15952).
      description: "Ungroup the pinDigest sweep — one pin per PR, not one fragile combined branch",
      matchUpdateTypes: ["pin", "pinDigest"],
      groupName: null,
    },
    {
      description: "1Password Connect Group",
      groupName: "1Password Connect",
      matchDatasources: ["docker"],
      matchPackageNames: ["/1password/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Actions Runner Controller Group",
      groupName: "Actions Runner Controller",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/gha-runner-scale-set-controller/",
        "/gha-runner-scale-set/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Flux Operator Group",
      groupName: "Flux Operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/", "/flux-operator-manifests/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Immich Group",
      groupName: "Immich",
      matchDatasources: ["docker"],
      matchPackageNames: ["/immich-app/immich-/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      // base + istiod MUST share a version (istiod dependsOn istio-base);
      // a skew breaks reconciliation. The old lockstep came from Renovate's
      // built-in "istio monorepo" preset keyed to the gcr.io path, which no
      // longer applies after the move to ghcr.io/istio/release/charts.
      description: "Istio Group",
      groupName: "Istio",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "ghcr.io/istio/release/charts/base",
        "ghcr.io/istio/release/charts/istiod",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Kubernetes Group",
      groupName: "Kubernetes",
      matchDatasources: ["docker"],
      // Anchored to the upstream registry path so unrelated images that happen
      // to contain "kubelet" (e.g. ghcr.io/postfinance/charts/kubelet-csr-approver)
      // don't get grouped here.
      matchPackageNames: [
        "registry.k8s.io/kube-apiserver",
        "registry.k8s.io/kube-controller-manager",
        "registry.k8s.io/kube-proxy",
        "registry.k8s.io/kube-scheduler",
        "registry.k8s.io/kubelet",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
    {
      description: "Rook-Ceph Group",
      groupName: "Rook-Ceph",
      matchDatasources: ["docker"],
      matchPackageNames: ["/rook-ceph/", "/rook-ceph-cluster/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
    },
  ],
}
