{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Major updates: always open a PR, never auto-merge — manual review",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": false,
      "automerge": false
    },
    {
      // Never auto-merge cluster-wide blast-radius infra, even minor/patch.
      // A bad minor here cascades cluster-wide: envoy-gateway 1.9.0 (a MINOR)
      // disabled Lua by default and set a 500 on every themed route
      // (2026-08-16). CNI, ingress gateway, storage backends, and the shared
      // app-template chart (re-renders ~110 releases) get manual review.
      "description": "Never auto-merge cluster-wide blast-radius infra (CNI, ingress, storage, shared chart)",
      "matchPackageNames": [
        "cilium",
        "docker.io/envoyproxy/gateway-helm",
        "ghcr.io/home-operations/charts-mirror/longhorn",
        "ghcr.io/bjw-s-labs/helm/app-template",
        "/^ghcr\\.io\\/rook\\/rook-ceph/"
      ],
      "automerge": false
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/kube-vip/kube-vip"],
      "sourceUrl": "https://github.com/kube-vip/kube-vip"
    },
    {
      // prompp/prompp is the Prometheus server image (a Prometheus fork).
      // prometheus-operator parses the image TAG as the Prometheus semver
      // `version`; a `@sha256:` digest in the tag fails that parse and stalls
      // ALL operator reconciliation (PrometheusOperatorSyncFailed — no
      // ServiceMonitor/alert change applies). The global `pinDigests: true`
      // appended the digest to the tag and did exactly this (#15979, also
      // #13091). Disable tag digest-pinning for this one image; the digest is
      // carried in the chart's separate `image.sha` field instead.
      "description": "prompp: never pin digest into the tag (breaks prometheus-operator version parse)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/prompp/prompp"],
      "pinDigests": false
    },
    {
      // The global `pinDigests: true` also reached the pre-commit manager,
      // which cannot write a digest pin: Renovate generated a "pin pre-commit
      // hook <repo> to" update with an EMPTY target for every hook, every
      // branch failed ("Error updating branch: update failure"), and the five
      // sat in the dashboard's Errored section from Feb 2026 onward.
      // Reproduced and verified with a lookup dry-run (Renovate 44.257.8):
      // 5 pinDigest updates before, 0 after, all 5 hooks still detected so
      // tag bumps keep flowing.
      "description": "pre-commit: no digest pinning (manager cannot write it; pin branches always error)",
      "matchManagers": ["pre-commit"],
      "pinDigests": false
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/cloudnative-pg/postgresql"],
      // The compatibility suffix must be OPTIONAL: every cluster pins a bare
      // `major.minor` tag (e.g. 17.7), but the old regex required a `-suffix`
      // and so matched nothing. (Detection of the `imageName:` field itself
      // lives in customManagers.json5 — without that, this versioning rule is
      // inert; the two must stay paired.)
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(-(?<compatibility>.+))?$",
      // Group all ~25 clusters into ONE PR and require manual review. A single
      // minor bump here fans out to ~25 rolling restarts + primary switchovers
      // (incl. authelia, the cluster-wide SSO SPOF). Auto-merging and trickling
      // those unattended is the exact concurrent-reconcile storm that took
      // authelia down on 2026-08-16, so this is cluster-wide blast-radius infra
      // like the CNI/ingress/storage rule above: Rob merges the single grouped
      // PR deliberately, in a chosen low-traffic window.
      "groupName": "cnpg-postgresql",
      "automerge": false,
      // Hold the fleet on PG 17. A PG MAJOR is NOT a rolling restart — it's an
      // offline pg_upgrade per cluster (the nametag 16->17 procedure, x25), so
      // moving to 18 must be a deliberately planned project, never an
      // auto-opened merge-ready PR. With docker:enableMajor + the major rule's
      // dependencyDashboardApproval:false, a "to 18.x" PR (18.0-18.6 exist as
      // of 2026-11) would otherwise surface on its own. Raise this bound when
      // the PG 18 upgrade is actually scheduled.
      "allowedVersions": "<18"
    },
    {
      description: 'Loose versioning for non-semver packages',
      matchDatasources: [
        'docker',
      ],
      versioning: 'loose',
      matchPackageNames: [
        '/changedetection/',
        '/qbittorrent/',
      ],
    },
    {
      groupName: 'omada-controller',
      matchDatasources: [
        'docker',
        'helm',
      ],
      matchPackageNames: [
        '/omada-controller/',
      ],
    },
    {
      // Music-assistant server: STABLE channel only (moved off the beta line
      // 2026-08-29 when 2.10.1 GA landed; the 2.10.0 beta hold is over). The
      // regex matches ONLY plain `major.minor.patch` stable tags, so the `bN`
      // betas AND the `.dev` nightlies structurally fail to match and are
      // never offered — no reliance on ignoreUnstable. Roll-forward within the
      // stable line is safe (schema-52/55 reads forward); the one-way schema
      // concern only bit on a downgrade to pre-2.10 stable. If you ever need to
      // chase a specific beta again, widen the regex with an optional
      // `(b(?<prerelease>\\d+))?` group. See memory: project_ma_schema52_stable_path.
      description: 'Custom versioning for music-assistant server (stable channel only)',
      matchDatasources: [
        'docker',
      ],
      versioning: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$',
      matchPackageNames: [
        'ghcr.io/music-assistant/server',
      ],
    },
    {
      description: "Custom versioning for frigate",
      matchDatasources: ["docker"],
      versioning: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(-(?<compatibility>rc|beta)(?<build>\\d+))?$",
      matchPackageNames: ["ghcr.io/blakeblackshear/frigate"]
    },
    {
      // rwlove/netbox is our wrapper image; its tag is the composite
      // `v<core>-plugins-v<bundle>` (e.g. v4.7.1-plugins-v0.1.3). Renovate
      // DETECTS the image (dashboard #10329 lists it) but default docker
      // versioning can't order the composite string, so it silently offered
      // ZERO bumps — the deployed image froze at v4.5.9 while rwlove/containers
      // advanced the core. Same failure mode as the CNPG postgres rule above.
      //
      // This orders on the NetBox CORE (major.minor.patch), so core drift is
      // caught; the plugin bundle is captured as `build` metadata.
      //
      // automerge: false is LOAD-BEARING here. The first-party
      // ghcr.io/rwlove/* rule in autoMerge.json5 auto-merges every rwlove
      // image with ignoreTests=true and no update-type gate — safe for the
      // stateless MCP servers and pump, but NOT for netbox: every core bump
      // runs a NetBox DB schema migration, and NetBox does not support
      // skipping minor versions. Left on automerge, Renovate would land a
      // 4.5 -> newest jump unattended (currently 4.7.1), skip-migrating the DB.
      // This override (packageRules is extended after autoMerge, so it wins)
      // forces a human to review, back up the CNPG DB, and walk the minors
      // one at a time (4.5 -> 4.6 -> 4.7). See home-ops#13303.
      description: 'Custom versioning for rwlove/netbox composite tag; human-gated (DB migration)',
      matchDatasources: ['docker'],
      versioning: 'regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-plugins-v(?<build>\\d+\\.\\d+\\.\\d+)$',
      matchPackageNames: ['ghcr.io/rwlove/netbox'],
      automerge: false,
    },
    {
      // The ollama image serves the fleet's qwen3-next:80b-a3b reasoning
      // model (ollama-spark) which cold-loads in ~9min off ceph — novel
      // hybrid-attention arch + ~50GB weights. Any image bump restarts
      // the pod and stalls the WHOLE reasoning tier (the 13 local-spark
      // agents + HolmesGPT + Open WebUI default chat) for that load. Gate
      // the (auto-merged, non-major) bump to the overnight routine window
      // so the stall lands at 02:00-05:00 ET, not mid-day. Both ollama
      // HelmReleases (spark + P40) share this image; overnight is fine for
      // the P40 one too. Window interpreted in the repo timezone
      // (America/New_York). See memory reference_qwen3_next_reasoning_model.
      description: "Schedule ollama image bumps to the overnight maintenance window — ollama-spark qwen3-next cold-load stalls the reasoning tier ~9min on restart.",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/ollama/ollama"],
      schedule: ["after 2am and before 5am"],
    }
  ]
}
