{
  "openapi": "3.0.3",
  "info": {
    "title": "LubeLogger (cooter scope)",
    "description": "Hand-authored OpenAPI subset of the LubeLogger REST API, scoped to the vehicle, service, repair, fuel (gas), odometer, reminder and note operations the cooter agent needs, plus read-only tax/upgrade/supply/plan records. LubeLogger ships no machine-readable OpenAPI document; this spec is maintained by hand from its HTML API reference (GET /api). Authentication is a static x-api-key header injected by the openapi-mcp bridge (not declared here).",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://lubelogger.selfhosted.svc.cluster.local:8080", "description": "in-cluster LubeLogger (overridden at runtime by --base-url)" }
  ],
  "tags": [
    { "name": "vehicle", "description": "Vehicle records" },
    { "name": "service", "description": "Service records" },
    { "name": "repair", "description": "Repair records" },
    { "name": "gas", "description": "Fuel / gas records" },
    { "name": "odometer", "description": "Odometer records" },
    { "name": "reminder", "description": "Maintenance reminders" },
    { "name": "note", "description": "Vehicle notes" },
    { "name": "tax", "description": "Tax records (read-only)" },
    { "name": "upgrade", "description": "Upgrade records (read-only)" },
    { "name": "supply", "description": "Supply records (read-only)" },
    { "name": "plan", "description": "Plan records (read-only)" }
  ],
  "paths": {
    "/api/vehicles": {
      "get": {
        "operationId": "getVehicles",
        "summary": "List all vehicles in the fleet",
        "tags": ["vehicle"],
        "responses": { "200": { "description": "Array of vehicles" } }
      }
    },
    "/api/vehicles/add": {
      "post": {
        "operationId": "addVehicle",
        "summary": "Add a new vehicle",
        "tags": ["vehicle"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Vehicle" } } } },
        "responses": { "200": { "description": "Vehicle created" } }
      }
    },
    "/api/vehicles/update": {
      "put": {
        "operationId": "updateVehicle",
        "summary": "Update an existing vehicle (body must include id)",
        "tags": ["vehicle"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Vehicle" } } } },
        "responses": { "200": { "description": "Vehicle updated" } }
      }
    },
    "/api/vehicles/delete": {
      "delete": {
        "operationId": "deleteVehicle",
        "summary": "Delete a vehicle by id (destructive)",
        "tags": ["vehicle"],
        "parameters": [ { "name": "id", "in": "query", "required": true, "schema": { "type": "integer" }, "description": "Vehicle id to delete" } ],
        "responses": { "200": { "description": "Vehicle deleted" } }
      }
    },

    "/api/vehicle/servicerecords": {
      "get": {
        "operationId": "getServiceRecords",
        "summary": "List service records for a vehicle",
        "tags": ["service"],
        "parameters": [ { "$ref": "#/components/parameters/vehicleId" } ],
        "responses": { "200": { "description": "Array of service records" } }
      }
    },
    "/api/vehicle/servicerecords/add": {
      "post": {
        "operationId": "addServiceRecord",
        "summary": "Add a service record to a vehicle",
        "tags": ["service"],
        "parameters": [ { "$ref": "#/components/parameters/vehicleId" } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ServiceRecord" } } } },
        "responses": { "200": { "description": "Service record created" } }
      }
    },
    "/api/vehicle/servicerecords/update": {
      "put": {
        "operationId": "updateServiceRecord",
        "summary": "Update a service record (body must include id)",
        "tags": ["service"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ServiceRecord" } } } },
        "responses": { "200": { "description": "Service record updated" } }
      }
    },
    "/api/vehicle/servicerecords/delete": {
      "delete": {
        "operationId": "deleteServiceRecord",
        "summary": "Delete a service record by id (destructive)",
        "tags": ["service"],
        "parameters": [ { "$ref": "#/components/parameters/recordId" } ],
        "responses": { "200": { "description": "Service record deleted" } }
      }
    },

    "/api/vehicle/repairrecords": {
      "get": {
        "operationId": "getRepairRecords",
        "summary": "List repair records for a vehicle",
        "tags": ["repair"],
        "parameters": [ { "$ref": "#/components/parameters/vehicleId" } ],
        "responses": { "200": { "description": "Array of repair records" } }
      }
    },
    "/api/vehicle/repairrecords/add": {
      "post": {
        "operationId": "addRepairRecord",
        "summary": "Add a repair record to a vehicle",
        "tags": ["repair"],
        "parameters": [ { "$ref": "#/components/parameters/vehicleId" } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ServiceRecord" } } } },
        "responses": { "200": { "description": "Repair record created" } }
      }
    },
    "/api/vehicle/repairrecords/update": {
      "put": {
        "operationId": "updateRepairRecord",
        "summary": "Update a repair record (body must include id)",
        "tags": ["repair"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ServiceRecord" } } } },
        "responses": { "200": { "description": "Repair record updated" } }
      }
    },
    "/api/vehicle/repairrecords/delete": {
      "delete": {
        "operationId": "deleteRepairRecord",
        "summary": "Delete a repair record by id (destructive)",
        "tags": ["repair"],
        "parameters": [ { "$ref": "#/components/parameters/recordId" } ],
        "responses": { "200": { "description": "Repair record deleted" } }
      }
    },

    "/api/vehicle/gasrecords": {
      "get": {
        "operationId": "getGasRecords",
        "summary": "List fuel / gas records for a vehicle",
        "tags": ["gas"],
        "parameters": [ { "$ref": "#/components/parameters/vehicleId" } ],
        "responses": { "200": { "description": "Array of gas records" } }
      }
    },
    "/api/vehicle/gasrecords/add": {
      "post": {
        "operationId": "addGasRecord",
        "summary": "Add a fuel / gas record to a vehicle",
        "tags": ["gas"],
        "parameters": [ { "$ref": "#/components/parameters/vehicleId" } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GasRecord" } } } },
        "responses": { "200": { "description": "Gas record created" } }
      }
    },
    "/api/vehicle/gasrecords/update": {
      "put": {
        "operationId": "updateGasRecord",
        "summary": "Update a fuel / gas record (body must include id)",
        "tags": ["gas"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/GasRecord" } } } },
        "responses": { "200": { "description": "Gas record updated" } }
      }
    },
    "/api/vehicle/gasrecords/delete": {
      "delete": {
        "operationId": "deleteGasRecord",
        "summary": "Delete a fuel / gas record by id (destructive)",
        "tags": ["gas"],
        "parameters": [ { "$ref": "#/components/parameters/recordId" } ],
        "responses": { "200": { "description": "Gas record deleted" } }
      }
    },

    "/api/vehicle/odometerrecords": {
      "get": {
        "operationId": "getOdometerRecords",
        "summary": "List odometer records for a vehicle",
        "tags": ["odometer"],
        "parameters": [ { "$ref": "#/components/parameters/vehicleId" } ],
        "responses": { "200": { "description": "Array of odometer records" } }
      }
    },
    "/api/vehicle/odometerrecords/latest": {
      "get": {
        "operationId": "getLatestOdometer",
        "summary": "Get the latest (current) odometer reading for a vehicle",
        "tags": ["odometer"],
        "parameters": [ { "$ref": "#/components/parameters/vehicleId" } ],
        "responses": { "200": { "description": "Latest odometer record" } }
      }
    },
    "/api/vehicle/odometerrecords/add": {
      "post": {
        "operationId": "addOdometerRecord",
        "summary": "Add an odometer record to a vehicle",
        "tags": ["odometer"],
        "parameters": [ { "$ref": "#/components/parameters/vehicleId" } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OdometerRecord" } } } },
        "responses": { "200": { "description": "Odometer record created" } }
      }
    },
    "/api/vehicle/odometerrecords/update": {
      "put": {
        "operationId": "updateOdometerRecord",
        "summary": "Update an odometer record (body must include id)",
        "tags": ["odometer"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OdometerRecord" } } } },
        "responses": { "200": { "description": "Odometer record updated" } }
      }
    },
    "/api/vehicle/odometerrecords/delete": {
      "delete": {
        "operationId": "deleteOdometerRecord",
        "summary": "Delete an odometer record by id (destructive)",
        "tags": ["odometer"],
        "parameters": [ { "$ref": "#/components/parameters/recordId" } ],
        "responses": { "200": { "description": "Odometer record deleted" } }
      }
    },

    "/api/vehicle/reminders": {
      "get": {
        "operationId": "getReminders",
        "summary": "List maintenance reminders for a vehicle",
        "tags": ["reminder"],
        "parameters": [ { "$ref": "#/components/parameters/vehicleId" } ],
        "responses": { "200": { "description": "Array of reminders" } }
      }
    },
    "/api/vehicle/reminders/add": {
      "post": {
        "operationId": "addReminder",
        "summary": "Add a maintenance reminder to a vehicle",
        "tags": ["reminder"],
        "parameters": [ { "$ref": "#/components/parameters/vehicleId" } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Reminder" } } } },
        "responses": { "200": { "description": "Reminder created" } }
      }
    },
    "/api/vehicle/reminders/update": {
      "put": {
        "operationId": "updateReminder",
        "summary": "Update a maintenance reminder (body must include id)",
        "tags": ["reminder"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Reminder" } } } },
        "responses": { "200": { "description": "Reminder updated" } }
      }
    },

    "/api/vehicle/notes": {
      "get": {
        "operationId": "getNotes",
        "summary": "List notes for a vehicle",
        "tags": ["note"],
        "parameters": [ { "$ref": "#/components/parameters/vehicleId" } ],
        "responses": { "200": { "description": "Array of notes" } }
      }
    },
    "/api/vehicle/notes/add": {
      "post": {
        "operationId": "addNote",
        "summary": "Add a note to a vehicle",
        "tags": ["note"],
        "parameters": [ { "$ref": "#/components/parameters/vehicleId" } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Note" } } } },
        "responses": { "200": { "description": "Note created" } }
      }
    },
    "/api/vehicle/notes/update": {
      "put": {
        "operationId": "updateNote",
        "summary": "Update a note (body must include id)",
        "tags": ["note"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Note" } } } },
        "responses": { "200": { "description": "Note updated" } }
      }
    },

    "/api/vehicle/taxrecords": {
      "get": {
        "operationId": "getTaxRecords",
        "summary": "List tax records for a vehicle (read-only)",
        "tags": ["tax"],
        "parameters": [ { "$ref": "#/components/parameters/vehicleId" } ],
        "responses": { "200": { "description": "Array of tax records" } }
      }
    },
    "/api/vehicle/upgraderecords": {
      "get": {
        "operationId": "getUpgradeRecords",
        "summary": "List upgrade records for a vehicle (read-only)",
        "tags": ["upgrade"],
        "parameters": [ { "$ref": "#/components/parameters/vehicleId" } ],
        "responses": { "200": { "description": "Array of upgrade records" } }
      }
    },
    "/api/vehicle/supplyrecords": {
      "get": {
        "operationId": "getSupplyRecords",
        "summary": "List supply records for a vehicle (read-only)",
        "tags": ["supply"],
        "parameters": [ { "$ref": "#/components/parameters/vehicleId" } ],
        "responses": { "200": { "description": "Array of supply records" } }
      }
    },
    "/api/vehicle/planrecords": {
      "get": {
        "operationId": "getPlanRecords",
        "summary": "List plan records for a vehicle (read-only)",
        "tags": ["plan"],
        "parameters": [ { "$ref": "#/components/parameters/vehicleId" } ],
        "responses": { "200": { "description": "Array of plan records" } }
      }
    }
  },
  "components": {
    "parameters": {
      "vehicleId": {
        "name": "vehicleId",
        "in": "query",
        "required": true,
        "schema": { "type": "integer" },
        "description": "Target vehicle id"
      },
      "recordId": {
        "name": "id",
        "in": "query",
        "required": true,
        "schema": { "type": "integer" },
        "description": "Record id to delete"
      }
    },
    "schemas": {
      "Vehicle": {
        "type": "object",
        "additionalProperties": true,
        "description": "LubeLogger vehicle. Omit id when adding; include id when updating. purchaseDate/purchasePrice are honored by the web form, not the JSON API.",
        "properties": {
          "id": { "type": "integer", "description": "Vehicle id (update only)" },
          "year": { "type": "integer" },
          "make": { "type": "string" },
          "model": { "type": "string" },
          "identifier": { "type": "string", "description": "Trim / nickname / plate shown on the card" },
          "licensePlate": { "type": "string" },
          "fuelType": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "extraFields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "properties": { "name": { "type": "string" }, "value": { "type": "string" } }
            }
          }
        }
      },
      "ServiceRecord": {
        "type": "object",
        "additionalProperties": true,
        "description": "Service or repair record. Omit id when adding; include id when updating. date is MM/DD/YYYY.",
        "properties": {
          "id": { "type": "integer", "description": "Record id (update only)" },
          "date": { "type": "string", "description": "MM/DD/YYYY" },
          "odometer": { "type": "integer" },
          "description": { "type": "string" },
          "cost": { "type": "number" },
          "notes": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["date", "odometer", "description", "cost"]
      },
      "GasRecord": {
        "type": "object",
        "additionalProperties": true,
        "description": "Fuel / gas fill-up record. Omit id when adding; include id when updating.",
        "properties": {
          "id": { "type": "integer", "description": "Record id (update only)" },
          "date": { "type": "string", "description": "MM/DD/YYYY" },
          "odometer": { "type": "integer" },
          "fuelConsumed": { "type": "number", "description": "Quantity of fuel added" },
          "cost": { "type": "number" },
          "isFillToFull": { "type": "boolean" },
          "missedFuelUp": { "type": "boolean" },
          "notes": { "type": "string" }
        },
        "required": ["date", "odometer", "fuelConsumed", "cost", "isFillToFull", "missedFuelUp"]
      },
      "OdometerRecord": {
        "type": "object",
        "additionalProperties": true,
        "description": "Odometer reading. Omit id when adding; include id when updating.",
        "properties": {
          "id": { "type": "integer", "description": "Record id (update only)" },
          "date": { "type": "string", "description": "MM/DD/YYYY" },
          "odometer": { "type": "integer" },
          "notes": { "type": "string" }
        },
        "required": ["date", "odometer"]
      },
      "Reminder": {
        "type": "object",
        "additionalProperties": true,
        "description": "Maintenance reminder. metric selects whether the reminder triggers on date, odometer, or either (Both). Omit id when adding; include id when updating.",
        "properties": {
          "id": { "type": "integer", "description": "Record id (update only)" },
          "description": { "type": "string" },
          "dueDate": { "type": "string", "description": "MM/DD/YYYY" },
          "dueOdometer": { "type": "integer" },
          "metric": { "type": "string", "enum": ["Both", "Date", "Odometer"] },
          "notes": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["description", "metric"]
      },
      "Note": {
        "type": "object",
        "additionalProperties": true,
        "description": "Vehicle note. The note body field is noteText (not note). Omit id when adding; include id when updating.",
        "properties": {
          "id": { "type": "integer", "description": "Record id (update only)" },
          "noteText": { "type": "string" },
          "description": { "type": "string" }
        },
        "required": ["noteText"]
      }
    }
  }
}
