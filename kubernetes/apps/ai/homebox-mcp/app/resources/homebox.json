{
  "openapi": "3.0.3",
  "info": {
    "title": "HomeBox (vila scope)",
    "description": "Hand-authored OpenAPI subset of the HomeBox REST API (sysadminsmedia fork v0.26), scoped to the asset, location and maintenance operations the vila property steward needs. IMPORTANT: this fork uses a UNIFIED ENTITY model — there is no /items or /locations. Everything is an `entity` under /api/v1/entities; a Location is just an entity-type with isLocation=true (POST /api/v1/entity-types), and an entity is placed under a location via parentId / categorized via entityTypeId. Verified live against /swagger/doc.json. Authentication is a static Authorization: Bearer <token> header injected by the openapi-mcp bridge (not declared here) — a long-lived HomeBox API token.",
    "version": "2.0.0"
  },
  "servers": [
    { "url": "http://homebox.selfhosted.svc.cluster.local:7745", "description": "in-cluster HomeBox (overridden at runtime by --base-url)" }
  ],
  "tags": [
    { "name": "entity", "description": "Assets / inventory entities (incl. warranty + purchase fields)" },
    { "name": "entity-type", "description": "Entity types; a type with isLocation=true is a Location" },
    { "name": "maintenance", "description": "Scheduled + completed maintenance entries on an entity" },
    { "name": "attachment", "description": "Files attached to an entity (manuals, warranty PDFs, photos)" }
  ],
  "paths": {
    "/api/v1/entities": {
      "get": {
        "operationId": "getEntities",
        "summary": "List/search entities (assets + locations). Query: q, page, pageSize. Summary rows; GET one entity for warranty/purchase detail.",
        "tags": ["entity"],
        "parameters": [
          { "name": "q", "in": "query", "required": false, "schema": { "type": "string" }, "description": "Full-text search" },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer" } },
          { "name": "pageSize", "in": "query", "required": false, "schema": { "type": "integer" } }
        ],
        "responses": { "200": { "description": "Paginated entities ({ items: [...], total, ... })" } }
      },
      "post": {
        "operationId": "createEntity",
        "summary": "Create an asset entity (minimal). Set entityTypeId to categorize and parentId to place it under a Location entity; PUT afterwards to set the rich fields.",
        "tags": ["entity"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EntityCreate" } } } },
        "responses": { "201": { "description": "Entity created (returns its id)" } }
      }
    },
    "/api/v1/entities/{id}": {
      "get": {
        "operationId": "getEntity",
        "summary": "Get one entity (full detail incl. warrantyExpires, lifetimeWarranty, warrantyDetails, purchase*, serial/model/manufacturer)",
        "tags": ["entity"],
        "parameters": [ { "$ref": "#/components/parameters/entityId" } ],
        "responses": { "200": { "description": "Entity" } }
      },
      "put": {
        "operationId": "updateEntity",
        "summary": "Update an entity (set serialNumber/modelNumber/manufacturer, purchase*, warrantyExpires, lifetimeWarranty, warrantyDetails, notes)",
        "tags": ["entity"],
        "parameters": [ { "$ref": "#/components/parameters/entityId" } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EntityUpdate" } } } },
        "responses": { "200": { "description": "Entity updated" } }
      },
      "delete": {
        "operationId": "deleteEntity",
        "summary": "Delete an entity (destructive)",
        "tags": ["entity"],
        "parameters": [ { "$ref": "#/components/parameters/entityId" } ],
        "responses": { "204": { "description": "Entity deleted" } }
      }
    },
    "/api/v1/entities/{id}/maintenance": {
      "get": {
        "operationId": "getEntityMaintenance",
        "summary": "List maintenance entries for an entity (status filter: scheduled|completed|both)",
        "tags": ["maintenance"],
        "parameters": [
          { "$ref": "#/components/parameters/entityId" },
          { "name": "status", "in": "query", "required": false, "schema": { "type": "string", "enum": ["scheduled", "completed", "both"] } }
        ],
        "responses": { "200": { "description": "Maintenance entries" } }
      },
      "post": {
        "operationId": "createEntityMaintenance",
        "summary": "Create a maintenance entry (scheduled when scheduledDate set; completed when completedDate set)",
        "tags": ["maintenance"],
        "parameters": [ { "$ref": "#/components/parameters/entityId" } ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MaintenanceEntryCreate" } } } },
        "responses": { "201": { "description": "Maintenance entry created" } }
      }
    },
    "/api/v1/entities/{id}/attachments": {
      "post": {
        "operationId": "createEntityAttachment",
        "summary": "Attach a file to an entity (multipart: file, type, name) — e.g. a Paperless warranty PDF or a nameplate photo",
        "tags": ["attachment"],
        "parameters": [ { "$ref": "#/components/parameters/entityId" } ],
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "type": "object", "additionalProperties": true, "properties": { "file": { "type": "string", "format": "binary" }, "type": { "type": "string" }, "name": { "type": "string" } } } } } },
        "responses": { "201": { "description": "Attachment created" } }
      }
    },
    "/api/v1/entity-types": {
      "get": {
        "operationId": "getEntityTypes",
        "summary": "List entity types (those with isLocation=true are Locations)",
        "tags": ["entity-type"],
        "responses": { "200": { "description": "Entity types" } }
      },
      "post": {
        "operationId": "createEntityType",
        "summary": "Create an entity type; set isLocation=true to create a Location",
        "tags": ["entity-type"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EntityTypeCreate" } } } },
        "responses": { "201": { "description": "Entity type created" } }
      }
    }
  },
  "components": {
    "parameters": {
      "entityId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "Entity UUID"
      }
    },
    "schemas": {
      "EntityCreate": {
        "type": "object",
        "additionalProperties": true,
        "description": "Minimum to create an entity (asset or location). Only name is required. entityTypeId categorizes it; parentId places it under a Location entity.",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "entityTypeId": { "type": "string", "description": "Entity-type UUID (e.g. a 'Home System' type)" },
          "parentId": { "type": "string", "description": "Parent entity UUID (a Location entity)" },
          "quantity": { "type": "integer" },
          "tagIds": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["name"]
      },
      "EntityUpdate": {
        "type": "object",
        "additionalProperties": true,
        "description": "Full entity update. Warranty + purchase fields are what vila cares most about. Dates are YYYY-MM-DD.",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "entityTypeId": { "type": "string" },
          "parentId": { "type": "string" },
          "serialNumber": { "type": "string" },
          "modelNumber": { "type": "string" },
          "manufacturer": { "type": "string" },
          "purchaseFrom": { "type": "string" },
          "purchasePrice": { "type": "number" },
          "purchaseDate": { "type": "string", "description": "YYYY-MM-DD" },
          "warrantyExpires": { "type": "string", "description": "YYYY-MM-DD — the date the vila digest watches" },
          "warrantyDetails": { "type": "string" },
          "lifetimeWarranty": { "type": "boolean" },
          "notes": { "type": "string" },
          "quantity": { "type": "integer" },
          "tagIds": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["name"]
      },
      "EntityTypeCreate": {
        "type": "object",
        "additionalProperties": true,
        "description": "Create an entity type. isLocation=true makes it a Location.",
        "properties": {
          "name": { "type": "string" },
          "isLocation": { "type": "boolean" },
          "icon": { "type": "string" }
        },
        "required": ["name"]
      },
      "MaintenanceEntryCreate": {
        "type": "object",
        "additionalProperties": true,
        "description": "A maintenance entry on an entity. Set scheduledDate for an upcoming task; set completedDate (and optionally cost) when done.",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "scheduledDate": { "type": "string", "description": "YYYY-MM-DD" },
          "completedDate": { "type": "string", "description": "YYYY-MM-DD" },
          "cost": { "type": "number" }
        },
        "required": ["name"]
      }
    }
  }
}
