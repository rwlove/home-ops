{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-openagent@latest"
  ],
  "provider": {
    "vllm-driver": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "vLLM Driver (Spark / GB10)",
      "options": {
        "baseURL": "http://vllm-driver-spark.ai.svc.cluster.local:8000/v1",
        "apiKey": "vllm"
      },
      "models": {
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B-A3B (Spark vLLM, agentic driver)",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    },
    "ollama-p40": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (P40)",
      "options": {
        "baseURL": "http://ollama.ai.svc.cluster.local:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen2.5:7b": {
          "name": "Qwen2.5 7B (P40)"
        },
        "qwen2.5-coder:7b": {
          "name": "Qwen2.5-Coder 7B (P40, small coder)"
        }
      }
    }
  },
  "model": "vllm-driver/qwen3.6-35b-a3b",
  "small_model": "ollama-p40/qwen2.5-coder:7b",
  "tools": {
    "lovenet-gateway_*": false,
    "lovenet-gateway_kubectl_analyze_network_policies": true,
    "lovenet-gateway_kubectl_analyze_pod_security": true,
    "lovenet-gateway_kubectl_check_crd_exists": true,
    "lovenet-gateway_kubectl_check_dns_resolution": true,
    "lovenet-gateway_kubectl_check_pod_health": true,
    "lovenet-gateway_kubectl_diagnose_network_connectivity": true,
    "lovenet-gateway_kubectl_diagnose_pod_crash": true,
    "lovenet-gateway_kubectl_get_admission_webhooks": true,
    "lovenet-gateway_kubectl_get_api_resources": true,
    "lovenet-gateway_kubectl_get_api_versions": true,
    "lovenet-gateway_kubectl_get_cluster_info": true,
    "lovenet-gateway_kubectl_get_cluster_roles": true,
    "lovenet-gateway_kubectl_get_cluster_version": true,
    "lovenet-gateway_kubectl_get_configmaps": true,
    "lovenet-gateway_kubectl_get_context_details": true,
    "lovenet-gateway_kubectl_get_cost_analysis": true,
    "lovenet-gateway_kubectl_get_crds": true,
    "lovenet-gateway_kubectl_get_current_context": true,
    "lovenet-gateway_kubectl_get_daemonsets": true,
    "lovenet-gateway_kubectl_get_deployments": true,
    "lovenet-gateway_kubectl_get_endpoints": true,
    "lovenet-gateway_kubectl_get_events": true,
    "lovenet-gateway_kubectl_get_evicted_pods": true,
    "lovenet-gateway_kubectl_get_hpa": true,
    "lovenet-gateway_kubectl_get_idle_resources": true,
    "lovenet-gateway_kubectl_get_ingress": true,
    "lovenet-gateway_kubectl_get_jobs": true,
    "lovenet-gateway_kubectl_get_limit_ranges": true,
    "lovenet-gateway_kubectl_get_logs": true,
    "lovenet-gateway_kubectl_get_namespace_cost_allocation": true,
    "lovenet-gateway_kubectl_get_namespaces": true,
    "lovenet-gateway_kubectl_get_node_metrics": true,
    "lovenet-gateway_kubectl_get_nodes": true,
    "lovenet-gateway_kubectl_get_nodes_summary": true,
    "lovenet-gateway_kubectl_get_overprovisioned_resources": true,
    "lovenet-gateway_kubectl_get_pdb": true,
    "lovenet-gateway_kubectl_get_persistent_volumes": true,
    "lovenet-gateway_kubectl_get_pod_conditions": true,
    "lovenet-gateway_kubectl_get_pod_events": true,
    "lovenet-gateway_kubectl_get_pod_metrics": true,
    "lovenet-gateway_kubectl_get_pod_security_info": true,
    "lovenet-gateway_kubectl_get_pods": true,
    "lovenet-gateway_kubectl_get_previous_logs": true,
    "lovenet-gateway_kubectl_get_priority_classes": true,
    "lovenet-gateway_kubectl_get_pvcs": true,
    "lovenet-gateway_kubectl_get_rbac_roles": true,
    "lovenet-gateway_kubectl_get_replicasets": true,
    "lovenet-gateway_kubectl_get_resource_quotas": true,
    "lovenet-gateway_kubectl_get_resource_quotas_usage": true,
    "lovenet-gateway_kubectl_get_resource_recommendations": true,
    "lovenet-gateway_kubectl_get_resource_trends": true,
    "lovenet-gateway_kubectl_get_resource_usage": true,
    "lovenet-gateway_kubectl_get_server_config_status": true,
    "lovenet-gateway_kubectl_get_service_accounts": true,
    "lovenet-gateway_kubectl_get_services": true,
    "lovenet-gateway_kubectl_get_statefulsets": true,
    "lovenet-gateway_kubectl_get_storage_classes": true,
    "lovenet-gateway_kubectl_gitops_app_get_tool": true,
    "lovenet-gateway_kubectl_gitops_app_status_tool": true,
    "lovenet-gateway_kubectl_gitops_app_sync_tool": true,
    "lovenet-gateway_kubectl_gitops_apps_list_tool": true,
    "lovenet-gateway_kubectl_gitops_detect_engine_tool": true,
    "lovenet-gateway_kubectl_gitops_source_get_tool": true,
    "lovenet-gateway_kubectl_gitops_sources_list_tool": true,
    "lovenet-gateway_kubectl_health_check": true,
    "lovenet-gateway_kubectl_list_crds": true,
    "lovenet-gateway_prom_*": true,
    "lovenet-gateway_cilium_*": true
  },
  "instructions": [
    "/root/.config/opencode/instructions/HOMELAB-SPEC.md",
    "/root/.config/opencode/instructions/persona-base.md"
  ],
  "mcp": {
    "lovenet-gateway": {
      "type": "remote",
      "url": "http://mcp-gateway-istio.mcp-system.svc.cluster.local:8080/mcp",
      "enabled": false,
      "headers": {
        "x-mcp-virtualserver": "opencode-readonly"
      }
    },
    "memory": {
      "type": "remote",
      "url": "http://memory-mcp.mcp-system.svc.cluster.local:8070/mcp",
      "enabled": true
    }
  }
}
