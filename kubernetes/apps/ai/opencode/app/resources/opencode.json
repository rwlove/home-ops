{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-openagent@latest"
  ],
  "provider": {
    "vllm-driver": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "vLLM Driver (Spark / GB10)",
      "options": {
        "baseURL": "http://vllm-driver-spark.ai.svc.cluster.local:8000/v1",
        "apiKey": "vllm"
      },
      "models": {
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B-A3B (Spark vLLM, agentic driver)",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    },
    "ollama-p40": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (P40)",
      "options": {
        "baseURL": "http://ollama.ai.svc.cluster.local:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen2.5:7b": {
          "name": "Qwen2.5 7B (P40)"
        }
      }
    }
  },
  "model": "vllm-driver/qwen3.6-35b-a3b",
  "small_model": "ollama-p40/qwen2.5:7b",
  "tools": {
    "lovenet-gateway_*": false
  },
  "instructions": [
    ".agents/instructions/*.md",
    "AGENTS.md"
  ],
  "mcp": {
    "lovenet-gateway": {
      "type": "remote",
      "url": "http://mcp-gateway-istio.mcp-system.svc.cluster.local:8080/mcp",
      "enabled": true
    }
  }
}
