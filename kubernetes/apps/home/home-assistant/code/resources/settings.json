{
  "editor.rulers": [100],
  "files.associations": {
    "*.yaml": "home-assistant"
  },
  "files.exclude": {
    "**/.cloud": true,
    "**/.storage": true,
    "**/__pycache__": true,
    "**/*.db*": true,
    "**/deps": true
  },
  "files.trimTrailingWhitespace": true,
  "files.watcherExclude": {
    "**/.cloud/**": true,
    "**/.git/objects/**": true,
    "**/.storage/**": true,
    "**/__pycache__/**": true,
    "**/*.db*": true,
    "**/*.log*": true,
    "**/backups/**": true,
    "**/deps/**": true,
    "**/tts/**": true
  },
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "search.exclude": {
    "**/.cloud": true,
    "**/.storage": true,
    "**/*.db*": true,
    "**/*.log*": true,
    "**/backups": true,
    "**/deps": true,
    "**/tts": true
  },
  "telemetry.telemetryLevel": "off",
  "terminal.integrated.fontFamily": "monospace",
  "update.mode": "none",
  "yaml.customTags": [
    "!env_var scalar",
    "!include scalar",
    "!include_dir_list scalar",
    "!include_dir_merge_list scalar",
    "!include_dir_merge_named scalar",
    "!include_dir_named scalar",
    "!input scalar",
    "!secret scalar"
  ],
  "[home-assistant]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnPaste": false,
    "editor.formatOnSave": false,
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  }
}
